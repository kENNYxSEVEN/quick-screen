# This value is compiled into the Vite bundle. Leave it empty for same-origin
# API and WebSocket requests at https://share.ingamers.pro.
VITE_API_ORIGIN=
# Optional comma-separated STUN URLs.
VITE_STUN_URLS=
# Set true only in a diagnostic build to log WebRTC stages and candidate types.
VITE_WEBRTC_DIAGNOSTICS=false
