MEDIA_PORT=3002
# Optional comma-separated STUN URLs.
MEDIA_STUN_URLS=
# Replace this placeholder with the VPS public IP only when address rewrite is required.
MEDIA_PUBLIC_IP=<PUBLIC_VPS_IP>
# Restrict Pion's UDP sockets to this firewall-friendly production range.
MEDIA_UDP_PORT_MIN=50000
MEDIA_UDP_PORT_MAX=50100
MEDIA_ICE_DIAGNOSTICS=false
