MEDIA_PORT=3002
# Optional comma-separated STUN URLs, for example: stun:stun.example.com:3478
MEDIA_STUN_URLS=
# Optional public IP for a 1:1 NAT/VPS address rewrite. Leave empty for local development.
MEDIA_PUBLIC_IP=
# Optional Pion UDP port range. Set both values for a constrained production firewall;
# leave both empty to use Pion's default ephemeral UDP behavior in local development.
MEDIA_UDP_PORT_MIN=
MEDIA_UDP_PORT_MAX=
# Enables candidate-type and selected-pair diagnostics without logging addresses or SDP.
MEDIA_ICE_DIAGNOSTICS=true
